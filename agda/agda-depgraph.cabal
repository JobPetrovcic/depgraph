cabal-version:      2.4
name:               agda-depgraph
version:            0.1.0
synopsis:           Agda with a backend that writes the dependency graph in the depgraph format
license:            MIT
build-type:         Simple

executable agda-depgraph
  main-is:          Main.hs
  build-depends:    base, Agda == 2.8.*, aeson, bytestring, containers, directory, filepath, text, deepseq
  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts -with-rtsopts=-I0
